extends layout

block content
    .container
        a(href='/login') Sign in
        h1 Create Contact
        
        form(action='/create', method='post')
            fieldset
                legend Basic Info
                    .form-group
                            label.col-form-label(for='first') First Name:
                            input.form-control(name='firstName', required)
                    .form-group
                            label.col-form-label(for='last') Last Name:
                            input.form-control(name='lastName', required)
                    .form-group
                            label.col-form-label(for='phone') Phone:
                            input.form-control(type='tel', name='phoneNumber', required)
                    .form-group
                            label.col-form-label(for='email') Email:
                            input.form-control(type='email', name='email', required)
            
            fieldset
                legend Address
                    .form-group
                            label.col-form-label(for='street') Street:
                            input.form-control(name='street', required)
                    .form-group
                            label.col-form-label(for='city') City:
                            input.form-control(name='city', required)
                    .form-group
                            label.col-form-label(for='state') State:
                            input.form-control(name='state', required)
                    .form-group
                            label.col-form-label(for='zip') Zip:
                            input.form-control(name='zip', required)
                    .form-group
                            label.col-form-label(for='country') Country:
                            input.form-control(name='country', required)
            
            fieldset
                legend Contact Preferences
                    .form-group
                            input.form-control(type='checkbox', name='contactByPhone')
                            label.col-form-label(for='contactByPhone') Contact by phone
                    .form-group
                            input.form-control(type='checkbox', name='contactByEmail')
                            label.col-form-label(for='contactByEmail') Contact by email
                    .form-group
                            input.form-control(type='checkbox', name='contactByMail')
                            label.col-form-label(for='contactByMail') Contact by mail
            
            button(type='submit') Add
            a(href='/') Cancel
        
    