extends layout
block content
    .container
        h1 Sign up
        if error
            p.error #{error}
        form(method='post', action='/signup')
            label First Name:
                    input.form-control(type='text', name='firstName', required)
            label Last Name:
                    input.form-control(type='text', name='lastName', required)
            label Username:
                    input.form-control(type='text', name='username', required)
            label Password:
                    input.form-control(type='password', name='password', required)
            label Confirm Password:
                    input.form-control(type='password', name='confirmPassword', required)
            button(type='submit') Sign up
            a(href='/') Nevermind
        p Already have an account? 
            a(href='/login') Sign in here!