extends layout

block content
    .container
        
        h1 Delete Contact
        h2 #{contact.FirstName} #{contact.LastName}
        
        p Are you sure you want to delete this contact?
        
        form(method='post', action='/' + contact.ID + '/delete')
            button.btn.btn-danger(type='submit', class="btn btn-success") Yes! 
            a(href='/' + contact.ID) Nevermind